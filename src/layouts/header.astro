---
import { SITE } from '../config';
import { Icon } from "astro-icon/components";

const { nav } = SITE;
---
<header class="header flex flex-col md:flex-row md:items-center md:justify-between p-4 md:p-8 bg-neutral-primary text-neutral-foreground">
    <div class="header">
        <a href="/" class="logo">
            <Icon name="bclogo" title={SITE.theme} width="60" height="60" class="w-10 h-10 text-[--text] dark:text-white" />
        </a>
    </div>
<nav id="nav">  
    <div class="navbar">
        <ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-default rounded-base bg-neutral-secondary-soft md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-neutral-primary">
            { 
                nav.map((item) => (
                    <li class="block py-2 px-3 text-white bg-brand rounded-sm md:bg-transparent md:text-fg-brand md:p-0"><a href={item.link} title="{item.key}">{item.text}</a></li>
                ))
            }

        </ul>
    </div> 
</nav>
</header>