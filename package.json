{
  "name": "brianc",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"npm run watch:css\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "watch:css": "tailwindcss -i ./src/css/main.css -o ./src/assets/css/main.css --watch",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./src/assets/css/main.css --minify"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.1.18",
    "approve": "^0.0.12",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "esbuild": "^0.28.2",
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "wrangler": "^4.35.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "workerd@1.20260925.1": true,
    "esbuild@0.28.1": true
  }
}
