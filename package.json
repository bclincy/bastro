{
  "name": "brianc",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"npm run watch:css\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "watch:css": "tailwindcss -i ./src/css/main.css -o ./dist/public/css/main.css --watch",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./dist/public/css/main.css --minify"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.8",
    "@astrojs/node": "^9.5.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.14.1",
    "astro-icon": "^1.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "wrangler": "^4.59.3"
  }
}
